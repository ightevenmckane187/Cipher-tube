{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CypherTubeDirectiveSchema",
  "description": "Validates runtime command injections and token sequences passed into the OmniSpiral stack.",
  "type": "object",
  "properties": {
    "directive_id": {
      "type": "string",
      "pattern": "^DIR_[A-Z0-9_]+$"
    },
    "syntax_pattern": {
      "type": "string",
      "description": "The exact regex pattern the incoming string token must match."
    },
    "target_engines": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "myth-physics",
          "cosmology",
          "identity-continuum",
          "destiny-field",
          "cycle-stack",
          "source-field",
          "paradox-field"
        ]
      },
      "minItems": 1
    },
    "execution_priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "allow_state_mutation": {
      "type": "boolean"
    }
  },
  "required": [
    "directive_id",
    "syntax_pattern",
    "target_engines",
    "execution_priority",
    "allow_state_mutation"
  ]
}
