{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "State Configuration",
  "type": "object",
  "properties": {
    "tier": {
      "type": "string",
      "enum": ["T0", "T1", "T5", "T8", "T9"]
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "config": {
      "type": "object"
    }
  },
  "required": ["tier"]
}
